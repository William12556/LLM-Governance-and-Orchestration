# Python
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/

# macOS
.DS_Store
**/.DS_Store
.zsh_history

# Logs and backups
# Note: on a case-insensitive filesystem '*.log' also matches AEL's 'ael_*.LOG'.
# That is intended for transient state, but archived run evidence is re-included
# below (loop.log_archive_dir).
*.log
**/*.log
*.bak
**/*.bak
*.BAK
**/*.BAK

# AEL preserved run logs — deliberately retained as run evidence
!ai/logs/
!ai/logs/**

# Obsidian
.obsidian/
*.canvas

# AI framework
workspace/report/
workspace/proposal/
workspace/proposal/closed/

# AEL ephemeral state
ai/state/ralph/

# dev/smoke harness — propagated framework copy, generated deliverable, and
# ael-mcp run records. The harness definition (task.md, tests/,
# config.reference.yaml) and dev/smoke-fixtures/ remain tracked.
dev/smoke/ai/
dev/smoke/src/
dev/smoke/.ael/
dev/eval/.venv/
dev/eval/.env
dev/eval/results/

# Model-specific configs (local only)
.model-config.local.yaml

# other
deprecated/
10000
test.txt
**/tmp
*.pdf
project_information.md

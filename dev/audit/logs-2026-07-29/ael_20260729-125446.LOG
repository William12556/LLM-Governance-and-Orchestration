2026-07-29 12:58:19,557 DEBUG tool result: def split_into_chunks(items, n):
    """
    Split a list of items into n chunks.
    
    Args:
        items: List of items to split
        n: Number of chunks to create
        
    Returns:
        List of exactly n lists, where each element of items appears exactly once,
        preserving original order, and chunk sizes differ by at most 1.
    """
    if n <= 0:
        raise ValueError("n must be >= 1")
    
    # Handle empty items list
    if not items:
        return [[] for _ in range(n)]
    
    # Calculate base size and remainder
    total_items = len(items)
    base_size = total_items // n
    remainder = total_items % n
    
    chunks = []
    start_index = 0
    
    for i in range(n):
        # First 'remainder' chunks get one extra item
        if i < remainder:
            chunk_size = base_size + 1
        else:
            chunk_size = base_size
        
        chunk = items[start_index:start_index + chunk_size]
        chunks.append(chunk)
        start_index += chunk_size
    
    return chunks


\n            continue\n        \n        print(f\"\u2713 PASSED for ({length}, {n})\")\n    \n    return all_passed\n\nif __name__ == \"__main__\":\n    if test_all_cases():\n        print(\"\\n\ud83c\udf89 All tests passed!\")\n        sys.exit(0)\n    else:\n        print(\"\\n\u274c Some tests failed!\")\n        sys.exit(1)"}

2026-07-29 12:53:19,003 DEBUG tool result: def split_into_chunks(items, n):
    """
    Split a list of items into exactly n chunks.
    
    Args:
        items: List of items to split
        n: Number of chunks to create (n >= 1)
    
    Returns:
        List of exactly n chunks where:
        - Every element appears exactly once
        - Original order is preserved
        - Chunk sizes differ by at most 1
    """
    if n == 0:
        raise ValueError("n must be >= 1")
    
    length = len(items)
    if length == 0:
        return [[] for _ in range(n)]
    
    # Calculate base size and number of chunks that need an extra item
    base_size = length // n
    extra = length % n
    
    chunks = []
    index = 0
    
    for i in range(n):
        # First 'extra' chunks get base_size + 1 items
        if i < extra:
            chunk_size = base_size + 1
        else:
            chunk_size = base_size
        
        chunk = items[index:index + chunk_size]
        chunks.append(chunk)
        index += chunk_size
    
    return chunks


2026-07-29 13:12:03,287 DEBUG tool result: def split_into_chunks(items, n):
    """
    Split a list of items into exactly n chunks.
    
    Args:
        items: List of items to split
        n: Number of chunks to create (n >= 1)
    
    Returns:
        A list of exactly n lists, where every element of items appears 
        exactly once across the returned chunks, preserving original order.
        Chunk sizes differ by at most 1.
    """
    if n == 0:
        raise ValueError("n must be >= 1")
    
    if not items:
        return [[] for _ in range(n)]
    
    length = len(items)
    chunk_size = length // n
    remainder = length % n
    
    chunks = []
    start = 0
    
    for i in range(n):
        if i < remainder:
            # First 'remainder' chunks get one extra element
            end = start + chunk_size + 1
        else:
            end = start + chunk_size
        
        chunks.append(items[start:end])
        start = end
    
    return chunks

